# Crystal Jade · environment
#
# The two public Sanity identifiers for the separate Crystal Jade Sanity
# project (never the GreenTee one). Both set: the embedded Studio at /studio
# is live and lib/content.ts fetches published content from Sanity. Either
# unset: the site serves the typed config in lib/content/ and the no-env
# build stays green (the standing extraction test).
#
# The dataset is public read; the app never needs a token. Real values live
# in .env.local, never committed.
#
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Script-only: the write token for scripts/seed.ts (pnpm seed). Create it in
# Sanity Manage with Editor permissions. Never needed by the app, the build,
# or the deploy; never add it to Vercel. Real value in .env or .env.local.
SANITY_SEED_TOKEN=
